---
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/about', label: 'About' },
  { href: '/experience', label: 'Experience' },
  { href: '/work', label: 'Work' },
  { href: '/posts', label: 'Posts' },
  { href: '/contact', label: 'Contact' },
];

const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(`${href}/`);
};
---

<nav class="site-nav">
  <a href="/" class="nav-logo">Faisal P<span>.</span></a>
  <div class="nav-links">
    {links.map((link) => (
      <a href={link.href} class:list={{ 'is-active': isActive(link.href) }}>
        {link.label}
      </a>
    ))}
  </div>
  <div class="nav-actions">
    <button type="button" class="search-toggle" id="search-toggle" aria-label="Search site">
      <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"/>
        <path d="m20 20-3.5-3.5"/>
      </svg>
    </button>
    <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch to dark mode">
      <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
      </svg>
      <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"/>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
      </svg>
    </button>
    <a href="/contact" class:list={['nav-cta', { 'is-active': isActive('/contact') }]}>contact</a>
  </div>
</nav>
