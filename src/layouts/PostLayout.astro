---
import BaseLayout from './BaseLayout.astro';
import ContentTags from '../components/ContentTags.astro';

interface Props {
  title: string;
  category: string;
  tags: string[];
  pubDate: Date;
  description: string;
}

const { title, category, tags, pubDate, description } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title}>
  <article class="section post">
    <header class="post-header reveal">
      <div class="post-meta">
        <span class="post-category">{category}</span>
        <span class="post-meta-separator">/</span>
        <time class="post-date" datetime={pubDate.toISOString()}>{formattedDate}</time>
      </div>
      <ContentTags tags={tags} class="post-tags" />
      <h1 class="post-title">{title}</h1>
      <p class="post-description">{description}</p>
    </header>

    <div class="post-content">
      <slot />
    </div>
  </article>
</BaseLayout>
